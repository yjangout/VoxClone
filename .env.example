# VoxCPM2 模型路径（本地目录或 Hugging Face id）
TTS_MODEL=/path/to/VoxCPM2

# 推理设备（默认 cuda）
TTS_DEVICE=cuda

# 音色库目录（相对项目根）
VOICES_DIR=voices

# 扩散步数（越大越稳越慢）
TTS_INFERENCE_TIMESTEPS=10

# CFG
TTS_CFG_VALUE=2.0

# 默认 speaker（须在 voices/ 中存在；不存在则用扫描到的第一个）
TTS_DEFAULT_SPEAKER=

# 上传音频大小上限（MB）
MAX_UPLOAD_MB=20

# 反代子路径（可选）。例如 nginx 挂到 https://host/beta/voxclone/
# 则设 BASE_PATH=/beta/voxclone ，页面/API/静态资源都会带此前缀。
# 本地直连 16009 时留空。
BASE_PATH=
